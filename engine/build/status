#!/usr/bin/env python3
"""STATUS.md 생성(엔진) — 손으로 고치지 않는다. domain/status.py 가 있으면 그 stdout 을 뒤에 붙인다."""
import sys, collections, subprocess
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib import *  # noqa

ts = all_tickets()
by_state = collections.Counter(t["_state"] for t in ts)
ver = (ROOT / "VERSION").read_text(encoding="utf-8").strip() if (ROOT / "VERSION").exists() else "?"
eng = (ROOT / "ENGINE_VERSION").read_text(encoding="utf-8").strip() if (ROOT / "ENGINE_VERSION").exists() else "?"
ready = ready_tickets()
L = [f"# STATUS (자동 생성 {now()}) — VERSION {ver} · engine {eng}", "",
     "## 티켓", "| open | doing | review | done | stranded |", "|---|---|---|---|---|",
     f"| {by_state['open']} | {by_state['doing']} | {by_state['review']} | {by_state['done']} | {by_state['stranded']} |", "",
     "### ready (다음에 집을 것)"]
L += [f"- {t['id']} P{t.get('priority', 2)} {t.get('type')} — {t.get('title')}" for t in ready] or ["- (없음)"]
L += ["", "### doing / review"]
L += [f"- {t['id']} [{t['_state']}] {t.get('title')} — claim {t.get('claim', {}).get('by', '')} {t.get('claim', {}).get('at', '')} pr {t.get('pr', '') or '-'}"
      for t in ts if t["_state"] in ("doing", "review")] or ["- (없음)"]
L += ["", "### stranded (반려 3회)"]
L += [f"- {t['id']} {t.get('title')} — notes: {str(t.get('notes', ''))[:120]}" for t in ts if t["_state"] == "stranded"] or ["- (없음)"]
L += ["", "## 최근 done 10"]
done = [t for t in ts if t["_state"] == "done"]
done.sort(key=lambda t: str(t.get("closed") or t.get("created") or ""), reverse=True)
L += [f"- {t['id']} {t.get('title')} ({t.get('closed', '')})" for t in done[:10]] or ["- (없음)"]
dom = ROOT / "domain" / "status.py"
if dom.exists():
    r = subprocess.run([sys.executable, str(dom)], cwd=ROOT, capture_output=True, text=True)
    if r.stdout.strip():
        L += ["", r.stdout.rstrip()]
(ROOT / "STATUS.md").write_text("\n".join(L) + "\n", encoding="utf-8")
print("\n".join(L[:14]))
