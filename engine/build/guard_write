#!/usr/bin/env python3
"""PreToolUse 훅 — Write/Edit 가 티켓 outputs 밖을 건드리면 차단(종료코드 2).
stdin: Claude Code 훅 JSON ({tool_name, tool_input:{file_path}}). TICKET 환경변수 없으면 통과(대화형)."""
import os, sys, json
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib import ROOT, load_ticket, rel

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
tool = data.get("tool_name", "")
if tool not in ("Write", "Edit", "MultiEdit", "NotebookEdit"):
    sys.exit(0)
tid = os.environ.get("TICKET", "").strip()
if not tid:
    sys.exit(0)
fp = (data.get("tool_input") or {}).get("file_path") or (data.get("tool_input") or {}).get("notebook_path") or ""
if not fp:
    sys.exit(0)
try:
    t = load_ticket(tid)
except FileNotFoundError:
    print(f"티켓 {tid} 없음 — 쓰기 차단", file=sys.stderr); sys.exit(2)
target = rel(Path(fp) if os.path.isabs(fp) else ROOT / fp)
allowed = [str(o) for o in (t.get("outputs") or [])]
ok = any(target == o or (o.endswith("/") and target.startswith(o)) for o in allowed)
if not ok:
    print(f"차단: {target} 은 티켓 {tid} 의 outputs 밖 — 허용: {allowed}. 발견한 일은 notes 에 discovered: 로 적어라.", file=sys.stderr)
    sys.exit(2)
sys.exit(0)
