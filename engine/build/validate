#!/usr/bin/env python3
"""검증기(엔진) — 완료는 여기서 판정한다. 티켓 스키마·VERSION·outputs 존재와 결함 티켓의 재현 TC(--ticket 일 때 실행)를 보고,
domain/validate.py 가 있으면 같은 인수로 호출해 결과를 합친다(도메인 규칙은 거기에).
사용: build/validate [--all] [--ticket T-xxxxxx] [--file path ...]
종료코드 0 = 통과, 1 = 오류 있음."""
from __future__ import annotations
import re, sys, subprocess
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib import *  # noqa

E: list[str] = []
W: list[str] = []


def err(f, msg): E.append(f"{rel(f)}: {msg}")
def warn(f, msg): W.append(f"{rel(f)}: {msg}")


def validate_ticket(f: Path):
    try:
        t = yaml.safe_load(f.read_text(encoding="utf-8")) or {}
    except yaml.YAMLError as e:
        return err(f, f"YAML 오류: {e}")
    for k in ("id", "type", "title", "goal", "inputs", "outputs", "dod", "limits", "created"):
        if k not in t:
            err(f, f"티켓 필드 누락: {k}")
    if t.get("id") != f.stem:
        err(f, f"id({t.get('id')}) ≠ 파일명({f.stem})")
    if t.get("type") not in TICKET_TYPES:
        err(f, f"type 값 오류: {t.get('type')} (허용: {TICKET_TYPES})")
    if not t.get("outputs"):
        err(f, "outputs 비어 있음")
    tc = str(t.get("tc") or "").strip()
    if t.get("type") == "defect" and not tc:
        err(f, "defect 티켓에 tc 없음 — 재현 TC 경로 필수(WORKFLOW.md §5)")
    if "tc" in (t.get("dod") or []) and not tc:
        err(f, "dod 에 tc 가 있는데 tc 경로 없음")
    if tc and not (ROOT / tc).is_file() and tc not in [str(o) for o in (t.get("outputs") or [])]:
        err(f, f"tc 파일 없음: {tc}")
    if (t.get("type") == "defect" or "tc" in (t.get("dod") or [])) and f.parent.name != "done" \
            and not str(t.get("assignee") or "").strip():
        warn(f, "결함 티켓에 assignee 없음 — 오케스트레이터 역할을 적는다(tk new --assignee, WORKFLOW.md §5)")
    if t.get("type") == "defect" and f.parent.name == "done":   # done = closed — tk close 를 거친 흔적이 있어야(D-0004)
        for k in ("fixed_in", "reviewed_by"):
            if not str(t.get(k) or "").strip():
                err(f, f"done(closed) defect 에 {k} 없음 — build/tk resolve·close 를 거치지 않았다(tk reopen 후 다시)")
    protected = (".claude/", "build/", ".github/", "STATUS.md", "VERSION", "ENGINE_VERSION", "tickets/")
    if t.get("type") != "process":
        for o in t.get("outputs") or []:
            if str(o).startswith(protected):
                err(f, f"outputs 경로 불허: {o} (process 티켓만 가능)")
    kb = int((t.get("limits") or {}).get("read_kb") or 60)
    total = 0
    for i in t.get("inputs") or []:
        spec = str(i)
        path, _, sel = spec.partition("#")
        p = ROOT / path
        if not (p.exists() and p.is_file()):
            continue
        if sel and p.suffix == ".json":
            # 선택자 조각만 읽는 입력은 조각 크기로 센다(전체 파일 크기로 세면 10MB JSON 의 한 카드가 티켓을 좌초시킨다 — T-2bf0dd 사고)
            try:
                import json as _json
                obj = _json.loads(p.read_text(encoding="utf-8"))
                cur = obj
                for k in sel.split("."):
                    cur = cur[int(k)] if isinstance(cur, list) else cur[k]
                total += len(_json.dumps(cur, ensure_ascii=False).encode())
            except Exception as e:
                err(f, f"inputs 선택자 해석 불가: {spec} ({type(e).__name__}: {e})")
        else:
            total += p.stat().st_size
    if total > kb * 1024:   # read_kb 는 작업자가 실행할 때 읽는 한도 — 실행 대상만 오류, 다시 실행될 수 있으면 권고, 끝난 티켓은 안 본다(D-0010)
        st, msg = f.parent.name, f"inputs 합계 {total//1024}KB > read_kb {kb}KB — 티켓을 쪼개거나 extract 로"
        if st in ("open", "doing"):
            err(f, msg)
        elif st in ("hold", "stranded"):
            warn(f, msg + "(다시 open 하기 전에)")
    ids = {x["id"] for x in all_tickets()}
    for b in t.get("blocked_by") or []:
        if b not in ids:
            err(f, f"blocked_by 참조 없음: {b}")


def validate_version():
    for name in ("VERSION",):
        p = ROOT / name
        if not p.exists():
            err(p, "없음"); continue
        v = p.read_text(encoding="utf-8").strip()
        if not re.match(r"^\d+\.\d+\.\d+(-[a-z0-9.]+)?$", v):
            err(p, f"semver 아님: {v}")


def main(argv):
    files, ticket, do_all = [], None, False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--all":
            do_all = True
        elif a == "--ticket":
            ticket = argv[i + 1]; i += 1
        elif a == "--file":
            files.append(Path(argv[i + 1])); i += 1
        else:
            files.append(Path(a))
        i += 1
    if ticket:
        t = load_ticket(ticket)
        validate_ticket(Path(t["_path"]))
        for o in t.get("outputs") or []:
            if not (ROOT / o).exists():
                err(ROOT / o, "outputs 파일이 만들어지지 않음")
        if t.get("type") == "defect" or "tc" in (t.get("dod") or []):
            rc, tail = run_tc(t)
            if rc != 0:
                err(Path(t["_path"]), f"tc 실패(exit {rc}): {t.get('tc')} — " + " | ".join(tail.splitlines()[-3:]))
            else:
                print(f"tc 통과: {t.get('tc')}")
    elif do_all or not files:
        for st in TICKET_STATES:
            for f in sorted((ROOT / "tickets" / st).glob("*.yaml")) if (ROOT / "tickets" / st).exists() else []:
                validate_ticket(f)
        validate_version()
    else:
        for f in files:
            if rel(f).startswith("tickets/") and f.suffix == ".yaml":
                validate_ticket(f)
    for w in W:
        print("권고 " + w)
    for e in E:
        print("오류 " + e)
    print(f"validate(engine): 오류 {len(E)} / 권고 {len(W)}")
    rc = 1 if E else 0
    dom = ROOT / "domain" / "validate.py"
    if dom.exists():
        r = subprocess.run([sys.executable, str(dom), *argv], cwd=ROOT)
        rc = rc or r.returncode
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
