#!/usr/bin/env python3
"""SessionStart 훅 — stdout 이 세션 컨텍스트에 들어간다.
첫 줄: 역할표가 없으면 「역할 미정 …」(WORKFLOW.md §1). 이어서 엔진 동기화 한 줄(대화형 = 동기화, 작업자 = 확인만, 30초 상한 — 실패해도 세션은 계속),
STATUS 머리 + 현재 티켓(작업자) 또는 장기기억 색인(대화형) + lessons."""
import os, sys, subprocess
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib import ROOT, ticket_path

tid = os.environ.get("TICKET", "").strip()
out = []
sync = ROOT / "build" / "engine_sync"


def run(args, cap):
    try:
        r = subprocess.run([sys.executable, str(sync), *args], cwd=ROOT, capture_output=True, text=True, timeout=cap)
        return r.stdout.strip().splitlines()
    except subprocess.TimeoutExpired:
        return [f"엔진 동기화 {cap}초 넘김 — 건너뜀(나중에 python3 build/engine_sync)"]
    except OSError as e:
        return [f"엔진 동기화 실행 실패 — {e}"]


if sync.exists():
    out += run(["--roles"], 10)                                    # 역할 미정이면 첫 줄
    cap = int(os.environ.get("MAWF_SESSION_SYNC_TIMEOUT", "30"))
    out.append("[엔진] " + " / ".join(l for l in run(["--check"] if tid else [], cap) if not l.startswith("역할 미정")))
who = " ".join(f"{k}={os.environ[k]}" for k in ("AGENT_NAME", "AGENT_ROLE") if os.environ.get(k))
if who:
    out.append(f"[세션] {who}")
st = ROOT / "STATUS.md"
if st.exists():
    out.append("[STATUS.md 머리]\n" + "\n".join(st.read_text(encoding="utf-8").splitlines()[:14]))
if tid:
    p = ticket_path(tid)
    out.append(f"[현재 티켓 {tid}]\n" + (p.read_text(encoding="utf-8") if p else "(티켓 파일 없음 — 아무것도 하지 말고 종료)"))
else:
    out.append("[티켓 없음] TICKET 환경변수가 없다. 대화형 세션이면 그대로 진행, 러너면 종료.")
    wf = ROOT / ".mawf" / "WORKFLOW.md"
    if wf.exists():
        out.append("[공통 운용 규칙] .mawf/WORKFLOW.md — 역할·지시 권한·결함(티켓+TC)·다중 세션 규칙. 필요한 절만 연다.")
    idx = ROOT / "notes" / "knowledge" / "INDEX.md"   # 장기기억 색인 — 대화형 세션(오케스트레이터)만 주입
    if idx.exists():
        out.append("[장기기억 색인 notes/knowledge/INDEX.md — 필요한 문서만 열 것]\n" + idx.read_text(encoding="utf-8"))
les = ROOT / "notes" / "lessons.md"
if les.exists():
    out.append(les.read_text(encoding="utf-8"))
print("\n\n".join(out))
