#!/usr/bin/env python3
"""SessionStart 훅 — stdout 이 세션 컨텍스트에 들어간다. STATUS 머리 + 현재 티켓 + lessons."""
import os, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib import ROOT, ticket_path

out = []
st = ROOT / "STATUS.md"
if st.exists():
    out.append("[STATUS.md 머리]\n" + "\n".join(st.read_text(encoding="utf-8").splitlines()[:14]))
tid = os.environ.get("TICKET", "").strip()
if tid:
    p = ticket_path(tid)
    out.append(f"[현재 티켓 {tid}]\n" + (p.read_text(encoding="utf-8") if p else "(티켓 파일 없음 — 아무것도 하지 말고 종료)"))
else:
    out.append("[티켓 없음] TICKET 환경변수가 없다. 대화형 세션이면 그대로 진행, 러너면 종료.")
les = ROOT / "notes" / "lessons.md"
if les.exists():
    out.append(les.read_text(encoding="utf-8"))
print("\n\n".join(out))
